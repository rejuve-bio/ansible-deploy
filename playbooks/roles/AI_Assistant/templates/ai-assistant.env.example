# LLM Configuration
BASIC_LLM_PROVIDER=local_model
BASIC_LLM_VERSION=gemma4
ADVANCED_LLM_PROVIDER=local_model
ADVANCED_LLM_VERSION=gemma4
GEMINI_API_KEY=REPLACE_WITH_YOUR_GEMINI_API_KEY
OPENAI_API_KEY=
LOCAL_MODEL_HOST=REPLACE_WITH_YOUR_LOCAL_MODEL_HOST
LOCAL_MODEL_API_KEY=REPLACE_WITH_YOUR_LOCAL_MODEL_API_KEY
MODEL_PATH=./models
VECTOR_COLLECTION=SITE_INFORMATION_gemini

# Flask
FLASK_PORT={{ ai_assistant_flask_port }}
JWT_SECRET=REPLACE_WITH_A_RANDOM_SECRET

# MongoDB - container name, not "mongodb" (collides with other roles').
MONGO_USERNAME=admin
MONGO_PASSWORD=REPLACE_WITH_A_PASSWORD
MONGO_DATABASE=ai_assistant
MONGO_URL=mongodb://admin:REPLACE_WITH_A_PASSWORD@ai-assistant-mongodb-local:27017/
MONGO_PORT_HOST={{ ai_assistant_mongo_port }}

# Redis - same reason, use the container name not the generic "redis" alias.
REDIS_HOST=ai-assistant-redis-local
REDIS_PORT=6379
REDIS_URL=redis://ai-assistant-redis-local:6379/0
REDIS_PORT_HOST={{ ai_assistant_redis_port }}

# Qdrant - app connects via QDRANT_CLIENT, not the host-published ports below.
QDRANT_CLIENT=http://ai-assistant-qdrant-local
QDRANT_PORT={{ ai_assistant_qdrant_port }}
QDRANT_GRPC_PORT={{ ai_assistant_qdrant_grpc_port }}

# Neo4j - same local atomspace as Annotation, via host.docker.internal.
NEO4J_URI=bolt://host.docker.internal:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=REPLACE_WITH_NEO4J_PASSWORD

# Galaxy MCP - via nginx's SSL passthrough, not the naked public IP.
GALAXY_MCP_SERVER=https://dev.rejuve.bio:8899/mcp

# External dependencies (not part of local deployment yet)
HYPOTHESIS_DATA_API=https://dev.rejuve.bio:5051
HYPOTHESIS_MAIN_ENDPOINT=https://dev.rejuve.bio:5051/hypothesis

# Image
AI_ASSISTANT_IMAGE={{ ai_assistant_image }}
