# Database Configuration
SQLALCHEMY_DATABASE_URI=postgresql://rejuvebio:atomspace123@db:5432/auth_service_db
POSTGRES_DB=auth_service_db
POSTGRES_USER=rejuvebio
POSTGRES_PASSWORD=atomspace123
SQLALCHEMY_TRACK_MODIFICATIONS=False

# JWT Configuration
JWT_SECRET_KEY=REPLACE_WITH_A_RANDOM_SECRET
SECRET_KEY=REPLACE_WITH_A_RANDOM_SECRET
JWT_ACCESS_TOKEN_EXPIRES=9000000
JWT_REFRESH_TOKEN_EXPIRES=2592000

# OAuth Configuration
GOOGLE_CLIENT_ID=REPLACE_WITH_YOUR_GOOGLE_CLIENT_ID
GOOGLE_CLIENT_SECRET=REPLACE_WITH_YOUR_GOOGLE_CLIENT_SECRET
GITHUB_CLIENT_ID=REPLACE_WITH_YOUR_GITHUB_OAUTH_CLIENT_ID
GITHUB_CLIENT_SECRET=REPLACE_WITH_YOUR_GITHUB_OAUTH_CLIENT_SECRET

# Mail Configuration
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=465
MAIL_USERNAME=REPLACE_WITH_YOUR_MAIL_USERNAME
MAIL_PASSWORD=REPLACE_WITH_YOUR_MAIL_APP_PASSWORD
DEFAULT_MAIL_SENDER=REPLACE_WITH_YOUR_MAIL_USERNAME
SECURITY_PASSWORD_SALT=REPLACE_WITH_A_RANDOM_SALT

# Host / Port Configuration
HOST_URL=localhost
HOST_PORT={{ auth_host_port }}
DB_PORT={{ auth_db_port }}
DOCKER_IMAGE_STAGING={{ auth_service_image }}
GALAXY_URL=http://mcp-app:8895
PLATFORM_URL=http://localhost:{{ platform_ui_port }}

# Flask
FLASK_APP=run.py
FLASK_ENV=development
