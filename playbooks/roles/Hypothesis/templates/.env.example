# MONGODB_URI=mongodb://mongo:27017
DB_NAME=default
MONGO_USER=admin
MONGO_PASSWORD=REPLACE_WITH_A_PASSWORD
MONGODB_URI=mongodb://admin:REPLACE_WITH_A_PASSWORD@mongo:27017/
OPENAI_API_KEY=REPLACE_WITH_YOUR_OPENAI_API_KEY
ANTHROPIC_API_KEY=REPLACE_WITH_YOUR_ANTHROPIC_API_KEY
HF_TOKEN=REPLACE_WITH_YOUR_HUGGINGFACE_TOKEN
JWT_SECRET_KEY=REPLACE_WITH_A_RANDOM_SECRET
JWT_SECRET=REPLACE_WITH_A_RANDOM_SECRET
# Add SocketIO configurations
SOCKETIO_PING_TIMEOUT=300
SOCKETIO_PING_INTERVAL=300
SOCKETIO_MAX_BUFFER_SIZE=100000000
ANNOTATION_URL=REPLACE_WITH_YOUR_ANNOTATION_URL
PREFECT_SERVICE_TOKEN=REPLACE_WITH_A_PREFECT_SERVICE_TOKEN
PROLOG_PORT=4244

DATA_DIR=./data
ONTOLOGY_CACHE_DIR=./data/ontology

HARMONIZER_REF_DIR=
HARMONIZER_CODE_REPO=/app/gwas-sumstats-harmoniser
HARMONIZER_SCRIPT_DIR=/app/scripts/1000Genomes_phase3

PLINK_DIR_37=/app/data/1000Genomes_phase3/plink_format_b38
PLINK_DIR_38=/app/data/1000Genomes_phase3/plink_format_b38

# HARMONIZER_REF_DIR_37=/app/data/harmonizer_ref/b37
HARMONIZER_REF_DIR_37=/app/data/harmonizer_ref/b38

# MinIO Configuration - container name over the shared network, not the bridge
# gateway IP + published port (that path requires 0.0.0.0, not 127.0.0.1-only).
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=REPLACE_WITH_YOUR_MINIO_ACCESS_KEY
MINIO_SECRET_KEY=REPLACE_WITH_YOUR_MINIO_SECRET_KEY
MINIO_BUCKET=hypothesis
MINIO_USE_SSL=false

ENSEMBL_HGNC_MAP=/app/data/ensembl_to_hgnc.pkl
HGNC_ENSEMBL_MAP=/app/data/hgnc_to_ensembl.pkl
GO_MAP=/app/data/go_map.pkl

# Database seeding paths
GWAS_MANIFEST_PATH=/app/data/Manifest_201807.csv
FINNGEN_MANIFEST_PATH=/app/data/finngen_R12_manifest.tsv
PHENOTYPES_JSON_PATH=/app/data/gwas_catalog_phenotypes.json
SKIP_SEED=false
GWAS_LIBRARY_BOOT_MODE=auto
GWAS_SHOWCASE_DELAY_SEC=1

GWAS_HYBRID_KEYWORD_MAX=10000
GWAS_SEMANTIC_MAX_DOCS=11900

PREFECT_DB_USER=prefect
PREFECT_DB_PASSWORD=REPLACE_WITH_A_PASSWORD
PREFECT_DB_NAME=prefect

LDSC_BASELINE_LD_PREFIX=data/OSF/baseline_v1.2/baseline.
LDSC_MERGED_CCRE_PREFIX=data/ldscores/all_merged_cCREs/all_merged_cCREs.
LDSC_W_LD_PREFIX=data/OSF/weights/weights.hm3_noMHC.
LDSC_W_HM3_SNPLIST=data/ldsc/data/w_hm3.snplist
LDSC_HM3_NO_MHC_LIST=data/1000Genomes_phase3/hm3_no_MHC.list.txt
LDSC_CTS_DIR=data/cts
LDSC_CTS_FALLBACK=data/cts/cell_types_available.cts
LDSC_CTS_FILE=data/cts/cell_types_available.cts
LDSC_PLINK_BFILE_PREFIX_PATTERN=data/1000Genomes_phase3/plink_files/{population}/1000G.{population}.hg38

MAIL_USERNAME=REPLACE_WITH_YOUR_MAIL_USERNAME
MAIL_PASSWORD=REPLACE_WITH_YOUR_MAIL_APP_PASSWORD
MAIL_FROM=REPLACE_WITH_YOUR_MAIL_USERNAME
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_TLS=true
MAIL_SSL=false
APP_BASE_URL=https://dev.rejuve.bio

DEMO_SEEDS_MINIO_PREFIX=demo-seeds-v2

GO_ENRICH_SNAPSHOT=true
GO_ENRICH_SNAPSHOT_DIR=tests/fixtures/snapshots
GO_SEMANTIC_STRATEGY=llm
GO_LLM_BACKEND=local            # or "openai"
GO_LLM_URL=REPLACE_WITH_YOUR_GO_LLM_URL
GO_LLM_KEY=ollama
GO_LLM_MODEL=gemma4
GO_LLM_MAX_CANDIDATES=0
GO_LLM_PREFILTER_PVALUE_K=200
GO_LLM_PREFILTER_K=300

CREDIBLE_SETS_DB_USER=credsets
CREDIBLE_SETS_DB_PASSWORD=REPLACE_WITH_A_PASSWORD
CREDIBLE_SETS_DB_NAME=credible_sets

PROLOG_OUT_V2_PATH=REPLACE_WITH_YOUR_PROLOG_OUT_V2_PATH
PROLOG_OUT_V3_PATH=REPLACE_WITH_YOUR_PROLOG_OUT_V3_PATH

SWIPL_HOST=REPLACE_WITH_YOUR_SWIPL_HOST
SWIPL_PORT=4545

# Local host ports
PROLOG_PORT_HOST={{ hypothesis_prolog_port }}
DASK_SCHEDULER_PORT_HOST={{ hypothesis_dask_scheduler_port }}
DASK_DASHBOARD_PORT_HOST={{ hypothesis_dask_dashboard_port }}
API_PORT_HOST={{ hypothesis_api_port }}
PREFECT_DB_PORT_HOST={{ hypothesis_prefect_db_port }}
CREDIBLE_SETS_DB_PORT_HOST={{ hypothesis_credible_sets_db_port }}
PREFECT_UI_PORT_HOST={{ hypothesis_prefect_ui_port }}
REDIS_PORT_HOST={{ hypothesis_redis_port }}

# Prebuilt images
PROLOG_IMAGE={{ hypothesis_prolog_image }}
DASK_SCHEDULER_IMAGE={{ hypothesis_dask_scheduler_image }}
DASK_WORKER_IMAGE={{ hypothesis_dask_worker_image }}
API_IMAGE={{ hypothesis_api_image }}
PREFECT_SERVICE_IMAGE={{ hypothesis_prefect_service_image }}
PREFECT_DEPLOYMENT_IMAGE={{ hypothesis_prefect_deployment_image }}
