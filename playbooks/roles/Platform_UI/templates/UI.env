# Called server-side (Node container), so use docker-network container names.
AUTH_URL=http://auth-service-local:5002
API_URL=http://hypothesis-local-api-service-1:5000
ANNOTATION_URL=http://annotation-service-local:{{ annotation_app_port }}
ANNOTATION_WEBSOCKET=ws://annotation-service-local:{{ annotation_app_port }}
AI_ASSISTANT_URL=http://ai-assistant-local:{{ ai_assistant_flask_port }}
HYPOTHESIS_WEBSOCKET=ws://hypothesis-local-api-service-1:5000

GALAXY_URL=
BIOBLEND_URL=
KG_INFO_URL=https://dev.rejuve.bio/kg-service/api/graph-info/file

# Self-reference (local instance, not the staging domain)
PLATFORM_URL=http://localhost:{{ platform_ui_port }}

# Signs login session cookies - required for auth to work. Auto-generated on
# first deploy and reused on every redeploy, no user action needed.
SESSION_SECRET={{ lookup('ansible.builtin.password', platform_ui_dir + '/.session_secret', length=48) }}

# Optional features, safe to leave blank for local use
UPLOAD_URL=
ISSUE_REPORTER_TOKEN=
ISSUE_REPORTER_REPO=
SURVEY_URL=
SURVEY_ENV=
