APP_PORT={{ annotation_app_port }}

# MongoDB - container name
MONGO_URI=mongodb://annotation-mongodb-local:27017/annotation

REDIS_PORT=6379
REDIS_URL=redis://annotation-redis-local:6379/0
REDIS_EXPIRATION=3600

NEO4J_URI=neo4j://REPLACE_WITH_YOUR_NEO4J_HOST:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=REPLACE_WITH_YOUR_NEO4J_PASSWORD
HUMAN_NEO4J_URI=bolt://REPLACE_WITH_YOUR_NEO4J_HOST:7687
HUMAN_NEO4J_USERNAME=neo4j
HUMAN_NEO4J_PASSWORD=REPLACE_WITH_YOUR_NEO4J_PASSWORD
FLY_NEO4J_URI=bolt://REPLACE_WITH_YOUR_NEO4J_HOST:7687
FLY_NEO4J_USERNAME=neo4j
FLY_NEO4J_PASSWORD=REPLACE_WITH_YOUR_NEO4J_PASSWORD

LLM_MODEL=gemini
GEMINI_API_KEY=REPLACE_WITH_YOUR_GEMINI_API_KEY

JWT_SECRET=REPLACE_WITH_A_RANDOM_SECRET
SECRET_KEY=REPLACE_WITH_A_RANDOM_SECRET

MAIL_SERVER=sandbox.smtp.mailtrap.io
MAIL_PORT=587
MAIL_USERNAME=REPLACE_WITH_YOUR_MAIL_USERNAME
MAIL_PASSWORD=REPLACE_WITH_YOUR_MAIL_PASSWORD
MAIL_DEFAULT_SENDER=REPLACE_WITH_YOUR_MAIL_USERNAME
MAIL_USE_TLS=False
MAIL_USE_SSL=False

SENTRY_DSN=
AXIOM_TOKEN=
AXIOM_DATASET=application-logs
AXIOM_PERFORMANCE_LOGS=performance-metrics

MORK_URL=http://REPLACE_WITH_YOUR_MORK_HOST:8431

PARENT_DIR=/tmp/test_data

DOCKER_HUB_REPO={{ annotation_image }}

MONGODB_DOCKER_PORT={{ annotation_mongodb_port }}
REDIS_DOCKER_PORT={{ annotation_redis_port }}
CADDY_PORT={{ annotation_caddy_port }}
CADDY_PORT_FORWARD={{ annotation_caddy_port }}
MEILI_PORT={{ annotation_meili_port }}

MEILI_MASTER_KEY=local_dev_master_key
MEILI_ENV=development

DEDUP_ENABLED=true
MORK_DATA_ROOT=REPLACE_WITH_YOUR_MORK_DATA_ROOT
MORK_DATA_DIR=REPLACE_WITH_YOUR_MORK_DATA_DIR
FLY_MORK_DATA_DIR=REPLACE_WITH_YOUR_FLY_MORK_DATA_DIR
